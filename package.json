{
  "name": "iterra-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Iterra — ระบบรับงานครบวงจรสำหรับบริษัทรับพัฒนาระบบ",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,gray \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed:team": "node --env-file-if-exists=.env server/seed-team.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^4.22.3",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
