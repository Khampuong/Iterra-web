# คัดลอกเป็น .env แล้วแก้ค่า
PORT=4000
# บัญชีผู้ดูแลระบบที่สร้างให้ตอนรันครั้งแรกเท่านั้น (ตอนที่ยังไม่มีผู้ใช้ในฐานข้อมูล)
# ถ้ามีบัญชีอยู่แล้ว ค่านี้จะไม่มีผล ให้เปลี่ยนรหัสผ่านในระบบแทน
ADMIN_EMAIL=admin@iterra.local
ADMIN_PASSWORD=iterra-admin
# คีย์ลับสำหรับเซ็น session (ถ้าไม่ใส่ ระบบจะสร้างเก็บไว้ใน data/)
SESSION_SECRET=
# อีเมลแจ้งเตือน: ใส่ SMTP_HOST เพื่อเปิดใช้ ถ้าเว้นว่าง ระบบจะแจ้งเตือนในระบบอย่างเดียว
# ตัวอย่าง Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 และใช้ App Password เป็น SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Iterra <no-reply@example.com>
# ที่อยู่ของระบบ ใช้ทำลิงก์ในอีเมล
APP_URL=http://localhost:5173
# Claude API สำหรับวิเคราะห์ Requirement และสร้างหน้า Demo
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_DISABLED=1
